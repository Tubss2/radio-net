[Unit]
Description=Radio Net API (communities, channels, LiveKit tokens)
After=network-online.target livekit.service
Wants=network-online.target

[Service]
User=radionet
Group=radionet
WorkingDirectory=/opt/radionet/server
EnvironmentFile=/etc/radionet/api.env
EnvironmentFile=/etc/radionet/secrets.env
Environment=PATH=/opt/radionet/node/bin:/usr/bin:/bin
ExecStart=/opt/radionet/node/bin/node --import tsx src/index.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Communities and channels live in /var/lib/radionet/store.json (RN_DATA_FILE). strict otherwise blocks the write.
StateDirectory=radionet
ReadWritePaths=/var/lib/radionet

[Install]
WantedBy=multi-user.target
