[Unit]
Description=LiveKit SFU (Radio Net voice)
After=network-online.target
Wants=network-online.target

[Service]
User=radionet
Group=radionet
ExecStart=/opt/radionet/bin/livekit-server --config /etc/radionet/livekit.yaml
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
