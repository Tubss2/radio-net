[Unit]
Description=LiveKit SFU (Radio Net voice)
After=network-online.target
Wants=network-online.target

[Service]
User=radionet
Group=radionet
ExecStart=/opt/radionet/bin/livekit-server --config /etc/radionet/livekit.yaml
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
# AF_NETLINK: LiveKit reads the routing table via netlink at startup.
# Without it the process crash-loops: route ip+net: netlinkrib: address family not supported by protocol.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
